{
  "name": "dota-2-gambling",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config tooling/depcruise.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src tooling",
    "test:integration": "vitest run tests/integration",
    "test:concurrency": "vitest run tests/concurrency",
    "test:db": "vitest run tests/db",
    "test:security": "vitest run tests/security",
    "test:invariants": "vitest run tests/invariants",
    "test:perf": "vitest run tests/perf",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check-drift": "tsx scripts/check-schema-drift.ts",
    "db:audit-grants": "tsx scripts/audit-grants.ts",
    "db:seed": "tsx db/seed/dev.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "coverage:merge": "tsx scripts/coverage-merge.ts",
    "coverage:check": "tsx scripts/coverage-check.ts",
    "test:manifest": "tsx scripts/test-manifest.ts",
    "check:money-format": "tsx scripts/check-money-formatting.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm knip && pnpm test && pnpm test:manifest && pnpm build",
    "verify:full": "pnpm verify && pnpm test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.24",
    "otplib": "^13.4.1",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.4",
      "postcss": ">=8.5.18"
    }
  }
}
