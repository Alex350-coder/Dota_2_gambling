# PLACEHOLDERS ONLY. This file is committed; .env is not (see .gitignore).
# Never put a real credential, key, token, connection string or endpoint here.
# PUBLIC SOURCE CODE != PUBLIC SECRETS.
#
# Every variable below is validated by the Zod schema in src/platform/config (T-007).
# The application refuses to boot if any required value is missing or malformed.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Money mode — SIMULATED is the only supported value (ADR-0009).
# REAL requires an immutable database money_mode row AND a complete
# production-readiness.json (all gates G-01..G-22). The app will not boot otherwise.
# ---------------------------------------------------------------------------
MONEY_MODE=SIMULATED
CURRENCY=PEN

# ---------------------------------------------------------------------------
# Database (local docker compose values — not a secret, not reachable externally)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betting_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Sessions & crypto
# Generate your own locally:  openssl rand -base64 48
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=sid
SESSION_TTL_HOURS=72
SESSION_STEPUP_MAX_AGE_MINUTES=15
ENCRYPTION_KEY=replace-me-with-a-locally-generated-48-byte-base64-value

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Responsible gambling defaults (minor units; 10000 = S/100.00)
# ---------------------------------------------------------------------------
RG_DEFAULT_DAILY_STAKE_LIMIT_MINOR=100000
RG_LIMIT_INCREASE_COOLING_OFF_HOURS=24
SIMULATED_CREDIT_DAILY_CAP_MINOR=100000

# ---------------------------------------------------------------------------
# Payments — no real provider is configured or supported (ADR-0008).
# Only the simulated adapter is constructible while MONEY_MODE=SIMULATED.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=simulated

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_TOKEN=replace-me-locally
