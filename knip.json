{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/domain/**/!(*.test).ts",
    "src/infra/**/!(*.test).ts",
    "src/application/**/!(*.test).ts",
    "scripts/**/!(*.test).ts",
